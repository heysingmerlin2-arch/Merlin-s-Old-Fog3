{
  "schemaVersion": 1,
  "id": "merlins_old_fog",
  "version": "${version}",
  "name": "Merlin's Old Fog",
  "description": "Brings back the classic Minecraft 1.8.9 fog. Compatible with Sodium.",
  "authors": ["Merlin"],
  "license": "MIT",
  "icon": "assets/merlins_old_fog/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.merlin.oldfog.MerlinsOldFog"],
    "modmenu": ["dev.merlin.oldfog.ModMenuIntegration"]
  },
  "mixins": ["merlins_old_fog.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.1",
    "minecraft": ">=26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "sodium": "*",
    "modmenu": "*"
  }
}
